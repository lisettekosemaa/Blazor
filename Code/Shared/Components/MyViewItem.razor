<dl class="row">
    <dt class="col-sm-2">@Label</dt>
    <dd class="col-sm-10">
        @if (Value is decimal dec)
        {
            @dec.ToString("C")
        }
        else if (Value is System.DateOnly d)
        {
            @d.ToString("d")
        }
        else if (Value is System.DateTime dt)
        {
            @dt.ToString("g")
        }
        else
        {
            @Value.ToString()
        }
    </dd>
</dl>

@code {
    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public object Value { get; set; }
}
