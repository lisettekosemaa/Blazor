@using Abc.Data.Common
@using Abc.Shared.Code
@using Microsoft.AspNetCore.Components.QuickGrid

@typeparam TEntity where TEntity : BaseEntity

<QuickGrid Class="table myTable" Items="Entities">
    @foreach (var p in typeof(TEntity).GetProperties())
    {
        @if (!show(p)) continue;
        <TemplateColumn Title="@p.Name" Context="x">
            @(value(p,x))
        </TemplateColumn>
    }

    <TemplateColumn Context="x">
        <a href="@($"{BasePath}/edit?id={x.Id}")">Edit</a> |
        <a href="@($"{BasePath}/details?id={x.Id}")">Details</a> |
        <a href="@($"{BasePath}/delete?id={x.Id}")">Delete</a>
    </TemplateColumn>
</QuickGrid>

<MyTablePageNav TotalCount="@TotalCount" CurrentUri="@Nav.Uri" Page="2" PageSize="5"></MyTablePageNav>

@code {
    private IQueryable<TEntity> Entities { get; set; }
    [Parameter] public IRepo<TEntity> Repo { get; set; }
    [Parameter] public string BasePath { get; set; }
    [Inject] private NavigationManager Nav { get; set; }
    private int TotalCount { get; set; }

    protected override async Task OnInitializedAsync() {
        if (Repo is null) return;
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = new UrlParams(uri).Parse();
        TotalCount = await Repo.CountAsync();
        Entities = (await Repo.GetAsync()).AsQueryable();
    }

    private string value(PropertyInfo p, TEntity e) {
        var v = p?.GetValue(e);
        return v?.ToString() ?? string.Empty;
    }

    private bool show(PropertyInfo p) {
        if (p is null) return false;
        if (p.Name == nameof(NamedEntity.Id)) return false;
        var t = p.PropertyType;
        if (t == typeof(string)) return true;
        if (typeof(IEnumerable).IsAssignableFrom(t)) return false;
        if (t.IsClass && t != typeof(string)) return false;
        return true;
    }
}

<style>
    .myTable {
        table-layout: fixed;
        width: 100%;
        max-width: 100%;
    }

    .myTable td {
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
</style>
