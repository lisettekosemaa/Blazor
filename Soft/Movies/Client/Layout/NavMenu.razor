@implements IDisposable
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Lisette Movies</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <MyNavLink href="" IconClass="home-icon" Text="Home" Match="NavLinkMatch.All"></MyNavLink>
        <MyNavLink href="counter" IconClass="counter-icon" Text="Counter"></MyNavLink>
        <MyNavLink href="weather" IconClass="list-icon" Text="Weather"></MyNavLink>
        <MyNavLink href="movies" IconClass="movie-icon" Text="Movies"></MyNavLink>
        <MyNavLink href="countries" IconClass="country-icon" Text="Countries"></MyNavLink>
        <MyNavLink href="currencies" IconClass="currency-icon" Text="Currencies"></MyNavLink>
        <MyNavLink href="countryCurrencies" IconClass="countryCurrency-icon" Text="Country Currencies"></MyNavLink>
        <MyNavLink href="monies" IconClass="money-icon" Text="Monies"></MyNavLink>
        <MyNavLink href="auth" IconClass="lock-icon" Text="Auth Required"></MyNavLink>
        <AuthorizeView>
            <Authorized>
                <MyNavLink href="Account/Manage" IconClass="person-icon" Text="@Name"></MyNavLink>
                <MyNavLink href="Account/Logout" IconClass="arrow-icon" Text="Logout">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                </MyNavLink>
            </Authorized>
            <NotAuthorized>
                <MyNavLink href="Account/Register" IconClass="register-icon" Text="Register"></MyNavLink>
                <MyNavLink href="Account/Login" IconClass="badge-icon" Text="Login"></MyNavLink>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string currentUrl;
    private string Name = string.Empty;
    protected override async Task OnInitializedAsync() {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        var context = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Name = context.User.Identity?.Name ?? string.Empty;
    }
    private void OnLocationChanged(object sender, LocationChangedEventArgs e) { 
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }
    public void Dispose() {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

