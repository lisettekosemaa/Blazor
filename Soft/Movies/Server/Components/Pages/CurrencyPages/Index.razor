@page "/currencies"
@rendermode InteractiveServer
@using System.Linq
@attribute [ExcludeFromInteractiveRouting]
@inject ICurrenciesRepo Repo

<MyIndexPage
    TItem="Currency"
    PageTitleText="Currencies Page"
    EntityTitle="Currencies"
    Items="currencies"
    BasePath="/currencies">
</MyIndexPage>

@code {
    private IQueryable<Currency> currencies = Enumerable.Empty<Currency>().AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        if (Repo is null) return;
        currencies = (await Repo.GetAsync()).AsQueryable();
    }
}
