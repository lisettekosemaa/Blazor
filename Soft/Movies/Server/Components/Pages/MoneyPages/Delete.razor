@page "/monies/delete"
@attribute [ExcludeFromInteractiveRouting]
@inject IMoniesRepo Repo
@inject NavigationManager NavigationManager

<MyDeletePage PageTitleText="Delete Money"
              EntityTitle="Money"
              Entity="money"
              BasePath="/monies"
              OnValidSubmit="DeleteMoney" />
@code {
    private Money money;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        money = await Repo.GetAsync(Id);
        if (money is null) NavigationManager.NotFound();
    }
    private async Task DeleteMoney()
    {
        await Repo.DeleteAsync(money!.Id);
        NavigationManager.NavigateTo("/monies");
    }
}
