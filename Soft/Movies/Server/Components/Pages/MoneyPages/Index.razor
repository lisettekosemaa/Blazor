@page "/monies"
@rendermode InteractiveServer
@using System.Linq
@attribute [ExcludeFromInteractiveRouting]
@inject IMoniesRepo Repo

<MyIndexPage
    TItem="Money"
    PageTitleText="Monies Index"
    EntityTitle="Monies"
    Items="monies"
    BasePath="/monies">
</MyIndexPage>

@code {
    private IQueryable<Money> monies = Enumerable.Empty<Money>().AsQueryable();

    protected override async Task OnInitializedAsync()
    {
        if (Repo is null) return;
        monies = (await Repo.GetAsync()).AsQueryable();
    }
}
