@page "/countries/details"
@using Abc.Data
@using Abc.Infra
@attribute [ExcludeFromInteractiveRouting]
@inject ICountriesRepo Repo
@inject NavigationManager NavigationManager

<MyDetailsPage 
    PageTitleText="Country Details" 
    EntityTitle="Country" 
    Entity="country" 
    BasePath="/countries" 
    EntityId="country?.Id" />

@code {
    private Country country;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        country = await Repo.GetAsync(Id);
        if (country is null) NavigationManager.NotFound();
    }
}
