@page "/movies/details"
@attribute [ExcludeFromInteractiveRouting]
@inject IMoviesRepo Repo
@inject NavigationManager NavigationManager

<MyDetailsPage 
    PageTitleText="Movie Details" 
    EntityTitle="Movie" 
    Entity="movie" 
    BasePath="/movies" 
    EntityId="movie?.Id" />

@code {
    private Movie movie;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        movie = await Repo.GetAsync(Id);
        if (movie is null) NavigationManager.NotFound();
    }
}
