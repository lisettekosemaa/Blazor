@page "/movies/delete"
@attribute [ExcludeFromInteractiveRouting]
@inject IMoviesRepo Repo
@inject NavigationManager NavigationManager

<MyDeletePage 
    PageTitleText="Delete Movie"
    EntityTitle="Movie"
    Entity="movie"
    BasePath="/movies"
    OnValidSubmit="DeleteMovie" />

@code {
    private Movie movie;
    [SupplyParameterFromQuery] private Guid Id { get; set; }
    protected override async Task OnInitializedAsync()
    {
        movie = await Repo.GetAsync(Id);
        if (movie is null) NavigationManager.NotFound();
    }
    private async Task DeleteMovie()
    {
        await Repo.DeleteAsync(movie!.Id);
        NavigationManager.NavigateTo("/movies");
    }
}
